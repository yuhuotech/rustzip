# Local development uses an ignored SQLite file and does not need a database service.
LOCAL_DATABASE_URL=file:./rustzip.local.db

# Vercel injects DATABASE_URL and DATABASE_URL_UNPOOLED for Preview/Production Neon.
# Never copy production database URLs into this local file.

# Stable random secret used to HMAC install UUIDs before they reach the database.
# Generate with: openssl rand -hex 32
TELEMETRY_HASH_SECRET=replace-with-at-least-32-random-characters

# Local public URL through the Nginx reverse proxy; Production uses https://rustzip.com.
SITE_URL=https://dev.rustzip.com
